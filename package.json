{
  "name": "fairway-browser-golf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "release": "npm run build && node tools/release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "bridge": "node bridge/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "bench": "node tools/bench.mjs",
  "profile": "node tools/profile.mjs",
  "gpu": "node tools/gpu-probe.mjs",
    "assets": "node tools/asset-preview.mjs && vite build --config vite.assets.config.js",
    "sheet": "vite build --config vite.sheet.config.js",
    "grove": "node tools/grow.mjs && node tools/asset-preview.mjs grown-redwood-forest && vite build --config vite.assets.config.js && vite build --config vite.sheet.config.js",
    "bridge:debug": "node bridge/server.mjs --debug"
  },
  "dependencies": {
    "lucide": "1.44.0",
    "three": "0.186.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "playwright": "^1.63.0",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3"
  },
  "license": "MIT"
}
