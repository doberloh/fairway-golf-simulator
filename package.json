{
  "name": "fairway-browser-golf",
  "version": "0.9.14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --config vite.builder.config.js && node tools/builder-guide.mjs && node tools/build-bridge.mjs",
    "release": "npm run build && node tools/build-server.mjs && node tools/release.mjs",
    "server": "node tools/build-server.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "bridge": "node bridge/server.mjs",
    "test": "node tools/test.mjs",
    "test:changed": "node tools/test.mjs --changed",
    "test:fast": "node tools/test.mjs --fast",
    "test:times": "node tools/test.mjs --save-times",
    "smoke": "npm run build && node tools/smoke.mjs",
    "bench": "node tools/bench.mjs",
    "profile": "node tools/profile.mjs",
    "gpu": "node tools/gpu-probe.mjs",
    "assets": "node tools/asset-preview.mjs && vite build --config vite.assets.config.js",
    "sheet": "vite build --config vite.sheet.config.js",
    "bridge:debug": "node bridge/server.mjs --debug",
    "blender": "node tools/blender/run.mjs"
  },
  "dependencies": {
    "laz-perf": "^0.0.7",
    "lucide": "1.44.0",
    "three": "0.186.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "bun": "^1.4.2",
    "playwright": "^1.63.0",
    "vite": "8.3.3",
    "vite-plugin-singlefile": "2.3.3"
  },
  "license": "MIT"
}
