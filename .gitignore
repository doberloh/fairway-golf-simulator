node_modules/
.DS_Store

# Snapshots taken before risky physics changes.
.checkpoints/

# Build output. `npm run build` regenerates dist/index.html from src/, and the
# release archives are cut from it, so none of it is source.
dist/
Fairway-portable.zip
Fairway-source.zip
RELEASE_SHA256.txt
# ...and the release archives UNZIPPED in place, which is how they get tested.
# Without this a `git add -A` once swept an unzipped Fairway-portable/ -- a
# 15.9 MB copy of the game -- into a commit (27 September; it is in history
# from ee1d401 and untracked since).
/Fairway-portable/
/Fairway-source/

# Scratch screenshots from `node tools/shot-sink.mjs`. Captures a report
# cites go beside that report, under docs/reports/, which is also local.
bench/shots/

# Reports, studies and saved sources are made for the owner and stay on this
# machine (AGENTS.md, *What stays local*). They were
# removed from the repository and from its history on 3 October 2026. The docs
# still name them as where to look locally; the tools that write them are
# tracked and regenerate them.
docs/reports/
docs/studies/
docs/sources/

# docs/sources/private/ (anything carrying a person's name or somebody else's
# data) is covered by docs/sources/ above. Nothing tracked lists what is in it,
# because a public document inventorying an ignored directory defeats the point.

# The asset contact sheet's data: 12 MB regenerated from vendor/ by
# `npm run assets`, so it is output rather than source. The page around it
# (preview/assets.html, preview/assets.js) IS source and is checked in.
preview/assets-data.js

# Grown, not vendored: 173 MB of OBJ across 418 files that
# `node tools/grow.mjs` reproduces EXACTLY from this repository's own code in
# a few seconds, depending on nothing outside it. Verified by hashing the
# folder, regenerating it and hashing again: byte-identical.
#
# Deliberately not committed. Every tuning pass on grow.mjs rewrites all 418
# files, so each one would add another ~173 MB to history permanently -- git
# cannot shed that later without rewriting history, and .git is already 81 MB.
# Nothing depends on the folder at build time: `npm run build` reads only
# src/, and the ingested result (src/asset-meshes.js) IS committed. Only
# `npm run assets` and `npm run grove` need it.
#
vendor/grown-redwood-forest/

# vendor/baked_assets: the composed and generated tree models (bake-assets.mjs,
# bake-trees.mjs) that `npm run assets` ingests. Kept on the owner's machine,
# no longer committed (30 September): 106 MB that nothing reads at build time,
# since the ingested result, src/asset-meshes.js, IS committed. Rebuilding it
# needs the model packs and the ez-tree devDependency. Its MIT notice, which
# must travel with the geometry that ships, is in docs/THIRD_PARTY_NOTICES.txt.
# The copies already in history stay there; nothing was rewritten.
vendor/baked_assets/

# run_fairway_server for each platform (tools/build-server.mjs) and the per-platform
# download ZIPs (tools/package_release.py): built, never committed.
/release/

# The website lives in its own, private repository since 7 October 2026. These
# stay ignored in case its build or a Netlify link is ever run in this folder
# by mistake: neither belongs in the game's public history.
/site-dist/
/.netlify/

# Secrets and per-machine settings never belong in the repository. Nothing of
# the kind exists here now (audited 2 October across every pushed version);
# these are here so that one created later is ignored by default.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
.npmrc
.claude/settings.local.json
